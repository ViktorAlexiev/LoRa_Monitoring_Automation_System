CONFIG_IDF_TARGET="esp32s3"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# esp-mqtt и Wi-Fi стекът - на ядро 0; приложението (изпълнение) - на ядро 1
CONFIG_MQTT_TASK_CORE_SELECTION_ENABLED=y
CONFIG_MQTT_USE_CORE_0=y
# постоянно захранен: без Power Management / лек сън
# crypto_common.cpp (компонент agro_core) се компилира във всяко приложение, което го ползва, и иска CMAC (в IDF е изключен по подразбиране)
CONFIG_MBEDTLS_CMAC_C=y
# без Task Watchdog (по желание на заданието): иначе IDF го пуска по подразбиране (5 s, само предупреждение)
CONFIG_ESP_TASK_WDT_INIT=n
