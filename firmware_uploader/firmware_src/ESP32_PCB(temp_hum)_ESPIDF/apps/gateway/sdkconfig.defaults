CONFIG_IDF_TARGET="esp32s3"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_MBEDTLS_CMAC_C=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# esp-mqtt и Wi-Fi стекът - на ядро 0; приложенията (радио) - на ядро 1
CONFIG_MQTT_TASK_CORE_SELECTION_ENABLED=y
CONFIG_MQTT_USE_CORE_0=y
# gateway е на мрежово захранване: без Power Management / лек сън
# Task Watchdog: 30 s и РЕСТАРТ (по подразбиране в ESP-IDF той само пише предупреждение); app_main го настройва и изрично
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_TASK_WDT_PANIC=y
# Прекъсването на DIO1 е в IRAM (EspHal на RadioLib инсталира GPIO службата с ESP_INTR_FLAG_IRAM): gpio_intr_disable() от ISR трябва да е в IRAM
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y
